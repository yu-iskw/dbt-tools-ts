{
  "name": "@dbt-tools/mcp",
  "version": "0.5.9",
  "description": "MCP server for long-lived dbt artifact analysis backed by @dbt-tools/core",
  "keywords": [
    "dbt",
    "mcp",
    "model-context-protocol",
    "analysis"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "yu-iskw",
  "repository": {
    "type": "git",
    "url": "https://github.com/yu-iskw/dbt-tools-ts.git"
  },
  "bugs": {
    "url": "https://github.com/yu-iskw/dbt-tools-ts/issues"
  },
  "homepage": "https://github.com/yu-iskw/dbt-tools-ts#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "dbt-tools-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "REFERENCE.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build && node ../../scripts/copy-dbt-tools-license.mjs",
    "test": "vitest run --project @dbt-tools/mcp",
    "test:watch": "vitest --project @dbt-tools/mcp"
  },
  "dependencies": {
    "@dbt-tools/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
