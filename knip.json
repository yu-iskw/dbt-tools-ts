{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["codeql", "grype", "make", "prettier", "trunk", "semgrep"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "stylelint.config.mjs"],
      "project": ["scripts/**/*.mjs"],
      "vitest": {
        "config": ["vitest.config.ts", "vitest.coverage.ts", "vitest.shared.ts"],
        "entry": ["packages/**/*.test.ts", "packages/**/*.test.tsx"]
      }
    },
    "packages/core": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreUnresolved": ["\\.js$"]
    },
    "packages/cli": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/mcp": {
      "entry": ["src/server.ts", "src/**/*.test.ts", "scripts/smoke-protocol.mjs"],
      "project": ["src/**/*.ts", "scripts/**/*.mjs"]
    },
    "packages/web": {
      "entry": [
        "e2e/**/*.ts",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/server/cli.ts",
        "src/workers/**/*.worker.ts"
      ],
      "project": ["src/**/*.ts", "src/**/*.tsx"],
      "ignoreFiles": ["src/constants/theme-colors.generated.ts"],
      "ignoreUnresolved": ["\\.js$"],
      "vite": true,
      "playwright": true
    },
    "packages/test-fixtures": {
      "entry": ["dbt-artifacts-parser/test-utils.ts"],
      "project": ["dbt-artifacts-parser/**/*.ts"]
    },
    "docs/site": {
      "entry": [".vitepress/config.ts"],
      "project": [".vitepress/**/*.ts"],
      "ignoreDependencies": ["vitepress"]
    }
  }
}
