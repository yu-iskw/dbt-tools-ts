{
  "name": "dbt-tools",
  "version": "0.6.0",
  "private": true,
  "description": "Standalone monorepo for the @dbt-tools packages.",
  "keywords": [
    "dbt",
    "analysis",
    "operational-intelligence"
  ],
  "license": "SEE LICENSE IN packages/LICENSE",
  "author": "yu-iskw",
  "scripts": {
    "build": "pnpm --recursive --sequential run build",
    "clean": "rm -rf ./packages/web/dist ./packages/web/dist-serve ./packages/web/playwright-report ./packages/web/test-results",
    "coverage:report": "node scripts/coverage-score.mjs",
    "dev:web": "pnpm --filter @dbt-tools/web dev",
    "format": "pnpm format:trunk && pnpm format:eslint && pnpm format:prettier",
    "format:all": "pnpm format:trunk-all",
    "format:eslint": "eslint . --fix",
    "format:prettier": "prettier --write .",
    "format:trunk": "pnpm exec trunk fmt",
    "format:trunk-all": "pnpm exec trunk fmt --all",
    "format:without-trunk": "pnpm format:eslint && pnpm format:prettier",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "lint": "pnpm lint:trunk && pnpm format:eslint && pnpm lint:eslint && pnpm lint:stylelint && pnpm knip",
    "lint:all": "pnpm lint:trunk-all && pnpm format:eslint && pnpm lint:eslint && pnpm security:grype",
    "lint:eslint": "eslint .",
    "lint:knip": "knip",
    "lint:report": "node scripts/eslint-score.mjs",
    "lint:security": "pnpm exec trunk check --all --scope security -y",
    "lint:stylelint": "stylelint \"packages/web/src/**/*.css\"",
    "lint:trunk": "pnpm exec trunk check -y",
    "lint:trunk-all": "pnpm exec trunk check --all -y",
    "security:grype": "grype .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @dbt-tools/web test:e2e",
    "tokens:check": "pnpm tokens:sync && git diff --exit-code packages/web/src/constants/theme-colors.generated.ts",
    "tokens:sync": "node scripts/sync-css-tokens-to-ts.mjs && prettier --write packages/web/src/constants/theme-colors.generated.ts",
    "trunk": "trunk",
    "site:dev": "pnpm --filter @dbt-tools/site dev",
    "site:build": "pnpm --filter @dbt-tools/site build",
    "site:preview": "pnpm --filter @dbt-tools/site preview",
    "verify:normalize": "pnpm format && pnpm lint",
    "verify:plugins": "bash plugins/tests/verify-agent-plugins.sh"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@trunkio/launcher": "^1.3.4",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.2.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jsdom": "^29.0.1",
    "knip": "^6.3.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3"
  },
  "packageManager": "pnpm@11.0.5",
  "engines": {
    "node": ">=24.13.0",
    "pnpm": ">=11.0.0"
  }
}
